# Public Supabase project URL. Safe for browser bundles.
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase publishable/anon key. Safe for browser bundles; RLS remains the security boundary.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public app origin used for Supabase Auth email redirects, for example http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Server-only Supabase service-role key used only by server actions for signup profile/role initialization.
# Never expose this to client components, browser bundles, or Capacitor clients.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Gemini API key for SkipQ customer AI ordering assistant.
# Obtain a free-tier key from https://aistudio.google.com/apikey
# Never expose this to client components or browser bundles.
GEMINI_API_KEY=

# Optional Gemini model override (defaults to gemini-2.5-flash).
# Supported models include gemini-2.5-flash, gemini-3.8-flash, gemini-3.7-flash.
GEMINI_MODEL=gemini-2.5-flash

